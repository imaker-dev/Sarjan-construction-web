{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@components/*": ["src/components/*"],
      "@store/*": ["src/store/*"],
      "@features/*": ["src/features/*"],
      "@layout/*": ["src/layout/*"],
      "@config/*": ["src/config/*"],
      "@constants/*": ["src/constants/*"],
      "@utils/*": ["src/utils/*"],
      "@hooks/*": ["src/hooks/*"],
      "@routes/*": ["src/routes/*"],
      "@assets/*": ["src/assets/*"],
      "@contexts/*": ["src/contexts/*"]
    }
  },
  "exclude": ["node_modules", "dist"]
}